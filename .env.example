# api
DATABASE_URL=postgresql://payscope:payscope@localhost:5432/payscope
TEST_DATABASE_URL=postgresql://payscope:payscope@localhost:5432/payscope_test
JWT_SECRET=                 # long random string: openssl rand -base64 48
JWT_EXPIRES_IN=1h
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
LOG_DB_MIN_LEVEL=warn

# web
VITE_API_URL=http://localhost:4000/api/v1

# seed (optional; not validated by the API config, read only by `pnpm db:seed`)
# DEMO_USER_PASSWORD=          # override the public demo password on a deployed environment
# ALLOW_PRODUCTION_SEED=true   # required to run the seed (it deletes all employees) when NODE_ENV=production
