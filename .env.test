# Template for running the integration test suite locally/in CI.
# Points DATABASE_URL at the same test database as TEST_DATABASE_URL
# so the app and the test runner never touch the dev database.
DATABASE_URL=postgresql://payscope:payscope@localhost:5432/payscope_test
TEST_DATABASE_URL=postgresql://payscope:payscope@localhost:5432/payscope_test
JWT_SECRET=test-only-secret-not-for-production-use
JWT_EXPIRES_IN=1h
NODE_ENV=test
PORT=4001
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=silent
LOG_DB_MIN_LEVEL=error

VITE_API_URL=http://localhost:4001/api/v1
