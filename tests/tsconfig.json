{
  "extends": "@payscope/typescript-config/react-library.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "declaration": false,
    "sourceMap": false,
    "types": ["node", "vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "paths": {
      "@api/*": ["../apps/api/src/*"],
      "@web/*": ["../apps/web/src/*"],
      "@shared/*": ["../packages/shared/src/*"],
      "@shared-types/*": ["../packages/types/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../apps/api/src/types/*.d.ts"],
  "exclude": ["node_modules"]
}
